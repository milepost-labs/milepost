{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test:design-system": "node --test scripts/check-design-system.test.mjs",
    "check:sample-tags": "node scripts/check-sample-tags.mjs",
    "test:sample-tags": "node --test scripts/check-sample-tags.test.mjs",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/accessibility.test.tsx",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "screenshots": "playwright test",
    "screenshots:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@milepost/attest": "^0.1.1",
    "@milepost/policy-spend": "^0.1.1",
    "@milepost/program": "^0.1.1",
    "@milepost/record": "^0.1.1",
    "@milepost/registry": "^0.1.1",
    "@stellar/freighter-api": "^6.0.1",
    "buffer": "6.0.3",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
